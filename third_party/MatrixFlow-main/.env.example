# MatrixFlow 环境变量配置
# 复制此文件为 .env 并填入实际的配置值
# cp .env.example .env

# Sentry 错误监控 DSN（必填）
SENTRY_DSN=
VITE_SENTRY_DSN=

# AI 提供商 API Keys（按需配置）
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# macOS 签名与公证（仅 macOS 打包时需要）
APPLE_ID=
APPLE_ID_PASSWORD=
APPLE_TEAM_ID=

# Windows 代码签名（仅 Windows 打包时需要）
WIN_CERT=
WIN_CERT_PASSWORD=
