{
  "name": "matrixflow",
  "version": "0.3.1",
  "description": "MatrixFlow — 多平台内容分发桌面应用",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && npm run build:electron && NODE_ENV=development electron .\"",
    "dev:vite": "vite",
    "dev:electron": "npm run build:electron && electron .",
    "build": "npm run build:electron && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && cp -r electron/data/migrations/*.sql dist/electron/data/migrations/ && cp -r electron/browser-ui dist/electron/browser-ui && cp -r electron/services/embedded-browser/stealth-scripts dist/electron/services/embedded-browser/stealth-scripts",
    "start": "npm run build && electron .",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.vue",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit",
    "test": "vitest run tests/unit tests/integration",
    "test:watch": "vitest tests/unit tests/integration",
    "test:coverage": "vitest run tests/unit tests/integration --coverage",
    "test:all": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:e2e": "vitest run tests/e2e",
    "test:e2e:watch": "vitest tests/e2e",
    "test:e2e:basic": "tsx tests/e2e/e2e-basic.test.ts",
    "test:login": "tsx scripts/test-login.ts",
    "test:publish": "tsx scripts/test-publish.ts",
    "pack": "npm run build && electron-builder --dir",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:win": "npm run build && electron-builder --win",
    "pack:linux": "npm run build && electron-builder --linux",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac --publish always",
    "dist:win": "npm run build && electron-builder --win --publish always",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@sentry/electron": "^7.13.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "better-sqlite3": "^12.10.0",
    "dompurify": "^3.4.4",
    "echarts": "^6.0.0",
    "electron-log": "^5.1.0",
    "electron-updater": "^6.1.0",
    "element-plus": "^2.5.0",
    "fluent-ffmpeg": "^2.1.3",
    "https-proxy-agent": "^9.0.0",
    "patchright": "^1.0.0",
    "pinia": "^2.1.0",
    "sharp": "^0.34.5",
    "socks-proxy-agent": "^10.0.0",
    "vue": "^3.4.0",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.3.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.3.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@pinia/testing": "^1.0.3",
    "@types/better-sqlite3": "^7.6.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.0.0",
    "@types/sharp": "^0.31.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.10",
    "concurrently": "^8.2.2",
    "electron": "^41.6.1",
    "electron-builder": "^26.8.1",
    "happy-dom": "^20.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.0.0",
    "wait-on": "^7.2.0"
  }
}
