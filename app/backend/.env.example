# SocialMediaAgent 配置示例
# 复制为 .env 后按需填写（.env 已被 .gitignore，绝不允许提交密钥）。
# 留空（保持注释）即使用内置默认值；密钥只从环境变量或 .env 读取，代码不硬编码。
# 新增配置项请同步更新 src/socialmedia_agent/config.py。

# ── 核心库（SQLite）──
# SMA_DB_URL=sqlite:///data/sma.db
# Memory 独立库（与核心库物理分离）
# SMA_MEMORY_DB_URL=sqlite:///data/sma_memory.db

# ── MediaCrawler 隔离环境（crawler venv 未装时保持默认即可）──
# SMA_MC_DIR=../third_party/MediaRadar-main/backend/services/crawler_service
# SMA_MC_PYTHON=.venv-crawler/Scripts/python.exe
# SMA_MC_DB=../third_party/MediaRadar-main/backend/data/sqlite_tables.db

# ── LLM（OpenAI 兼容端点，如 DeepSeek）──
# 填入有效 key 才启用 LLM 链路；留空则全部 Agent 走规则兜底。
# LLM_API_KEY=sk-xxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_TIMEOUT=60

# ── 角色级模型覆盖（可选）──
# 每个 Agent 角色可单独指定模型；未配置的角色回落 LLM_MODEL。
# 用途：推理重的角色用强模型，轻量角色用更快/更便宜的模型。
# 可用角色：ACCOUNT_STRATEGY / CONTENT_ANALYSIS / TREND_ANALYSIS /
#           TOPIC_RECOMMENDATION / TITLE_OPTIMIZATION
# 示例：Strategy 用推理模型，标题优化用轻量模型
# LLM_MODEL_ACCOUNT_STRATEGY=deepseek-flash
# LLM_MODEL_TITLE_OPTIMIZATION=deepseek-chat

# ── RAG 知识库 ──
# 向量库持久化路径（`python -m socialmedia_agent.cli.seed_knowledge` 写入；启动时装载）
# SMA_KNOWLEDGE_STORE=data/knowledge/knowledge.index
# 嵌入模型（可选）：配置了且 LLM_API_KEY 有效时用 OpenAI 兼容 embedding 端点，
# 否则回退本地确定性哈希嵌入（无需外部依赖）。
# SMA_EMBEDDING_MODEL=BAAI/bge-m3

# ── 周报目录（周报落盘位置；GET /reports 与 GET /system/status 读取它）──
# SMA_REPORT_DIR=data/reports
